# Copy this file to .env (gitignored) and fill in real values.
# Never commit a file named .env with real values in it.
# Set the same names as env vars on Render for production.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=

# Auth
JWT_SECRET=
JWT_EXPIRE=7d

# Twilio (SMS/WhatsApp alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Resend (email)
RESEND_API_KEY=
EMAIL_FROM=

# Firebase Admin SDK — paste the full service account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT=

# Google Maps (server-side use, e.g. geocoding) — restrict this key in
# Google Cloud Console to your server's outbound IP or referrer, separate
# from the mobile app's Android-restricted key
GOOGLE_MAPS_API_KEY=

# CORS — comma-separated list of allowed dashboard origins
ALLOWED_ORIGINS=

# Error tracking (optional — leave blank to disable)
SENTRY_DSN=
